# KineLab web frontend (R1 production): build -> nginx static serving.
# Build args: VITE_BIOMECH_URL, VITE_RELEASE_CHANNEL, VITE_APP_VERSION.
FROM node:22-slim AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . ./
ARG VITE_BIOMECH_URL=/api
ARG VITE_RELEASE_CHANNEL=RESEARCH_PREVIEW
ARG VITE_APP_VERSION=0.1.0-beta
ENV VITE_BIOMECH_URL=${VITE_BIOMECH_URL} \
  VITE_RELEASE_CHANNEL=${VITE_RELEASE_CHANNEL} \
  VITE_APP_VERSION=${VITE_APP_VERSION} \
  VITE_E2E_MODE=false
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
