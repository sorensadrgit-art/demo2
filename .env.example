# KineLab production environment contract (placeholders only — no secrets).
# Copy to .env and fill in per deployment. Never commit real secrets.
#
# Release channel: DEVELOPMENT | RESEARCH_PREVIEW | CLINICAL_RESEARCH
# CLINICAL_PRODUCTION is NOT offered in R1 (physical + clinical validation pending).
KINELAB_RELEASE_CHANNEL=RESEARCH_PREVIEW

# --- APP ---
VITE_BIOMECH_URL=http://127.0.0.1:8101
VITE_APP_VERSION=0.1.0-beta
VITE_RELEASE_CHANNEL=RESEARCH_PREVIEW
# E2E fixture hooks: NEVER true in production (dev/CI only).
VITE_E2E_MODE=false

# --- BACKEND ---
KINELAB_BACKEND_HOST=127.0.0.1
KINELAB_BACKEND_PORT=8101
# Explicit origins, comma-separated. Never "*" for credentialed production.
KINELAB_CORS_ORIGINS=https://kinelab.example.org
KINELAB_STORAGE_ROOT=/var/lib/kinelab
KINELAB_LOG_LEVEL=INFO

# --- RTMW ---
KINELAB_RTMW_URL=http://127.0.0.1:8102
KINELAB_PRECISION_POSE_PROVIDER=rtmw-l-256x192

# --- OPENSIM ---
KINELAB_OPENSIM_MODEL=/var/lib/kinelab/models/gait2392_thelen2003muscle.osim

# --- CAPTURE ---
KINELAB_MAX_BUNDLE_MB=4096
KINELAB_MAX_VIDEO_MB=2048
KINELAB_MAX_CAMERAS=12
KINELAB_MAX_MANIFEST_KB=256
KINELAB_MAX_TIMESTAMP_ROWS=200000

# --- CONCURRENCY ---
KINELAB_MAX_CONCURRENT_JOBS=2

# --- SECURITY ---
# Reverse-proxy public base URL (no hardcoded sandbox hosts in production).
KINELAB_PUBLIC_URL=https://kinelab.example.org
